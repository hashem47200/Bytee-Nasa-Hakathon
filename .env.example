# --------------------------------------------------------------------------
# NASA Explorer Hub Environment Configuration
# --------------------------------------------------------------------------
DJANGO_SECRET_KEY=nasa-explorer-hub-secret-key-prod-2026-xyz
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,*

# Database Configuration Options:
# 1. PostgreSQL (recommended for production):
# DATABASE_URL=postgres://postgres:password@localhost:5432/nasa_explorer_db
# Or granular parameters:
# DB_ENGINE=postgres
# DB_NAME=nasa_explorer_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# 2. MySQL / MariaDB:
# DATABASE_URL=mysql://root:password@localhost:3306/nasa_explorer_db
# Or:
# DB_ENGINE=mysql
# DB_NAME=nasa_explorer_db
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306

# When neither DATABASE_URL nor DB_ENGINE is provided, the application safely
# defaults to local relational SQLite storage for immediate execution.
